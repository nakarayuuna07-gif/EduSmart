# === 1. Gemini (Google) - Prioritas 1 ===
# Di AI Studio, GEMINI_API_KEY disuntikkan otomatis melalui Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# === 2. ChatGPT (OpenAI) - Prioritas 2 ===
# Kosongkan API key jika tidak dipakai (provider otomatis dilewati).
OPENAI_API_KEY=""
# PERLU VERIFIKASI: pastikan akun OpenAI Anda memiliki akses ke gpt-5-nano (alternatif: gpt-4.1-nano atau gpt-4o-mini).
OPENAI_MODEL="gpt-5-nano"

# === 3. Claude (Anthropic) - Prioritas 3 ===
ANTHROPIC_API_KEY=""
# PERLU VERIFIKASI: sesuaikan dengan alias Haiku aktif pada akun Anthropic Anda (misal claude-haiku-5-5 atau claude-haiku-4-5).
ANTHROPIC_MODEL="claude-haiku-5-5"

# === 4. DeepSeek - Prioritas 4 ===
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# === 5. Groq - Prioritas 5 ===
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# === 6. Mistral - Prioritas 6 ===
MISTRAL_API_KEY=""
# PERLU VERIFIKASI: ministral-3b-latest adalah model termurah; alternatif mistral-small-latest.
MISTRAL_MODEL="ministral-3b-latest"

# === 7. OpenRouter - Prioritas 7 ===
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# === Pengaturan Runtime ===
# Opsional: mode simulasi untuk pengujian fallback tanpa memanggil API sungguhan (contoh: gemini:429,openai:503)
# AI_MOCK_PROVIDERS=""
APP_URL="MY_APP_URL"
PORT="3000"
